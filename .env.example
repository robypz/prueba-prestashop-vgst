# ==============================================================================
# PrestaShop Docker Environment Configuration
# ==============================================================================

# --- Puertos del Host ---
PS_PORT=80
DB_PORT=3306
PMA_PORT=8081

# --- Base de Datos MySQL ---
DB_SERVER=db
DB_NAME=prestashop
DB_USER=prestashop
DB_PASSWORD=prestashop
DB_ROOT_PASSWORD=root
DB_PREFIX=ps_

# --- Configuración de PrestaShop ---
PS_DOMAIN=localhost
PS_LANGUAGE=es
PS_COUNTRY=es

# Modo de Instalación:
# 0 = Manual interactivo vía navegador (accede a http://localhost/install/)
# 1 = Instalación automática CLI al arrancar el contenedor
PS_INSTALL_AUTO=0

# Modo de Desarrollo / Depuración (1 = activado, 0 = desactivado)
PS_DEV_MODE=1

# Modo Demo con datos de prueba (1 = activado, 0 = desactivado)
PS_DEMO_MODE=0

# SSL y Dominio dinámico
PS_ENABLE_SSL=0
PS_HANDLE_DYNAMIC_DOMAIN=0

# Credenciales de Administrador (usadas si PS_INSTALL_AUTO=1)
ADMIN_MAIL=admin@prestashop.local
ADMIN_PASSWORD=Prestashop123!
